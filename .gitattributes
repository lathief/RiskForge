* text=auto
*.sh text eol=lf
artisan text eol=lf
# Vendored Swagger UI: byte-for-byte as published, never line-ending converted.
public/swagger/vendor/** -text
# Generated by scripts/generate-postman.sh with LF; --check compares bytes.
api/postman/*.json text eol=lf
*.js text eol=lf
# Go sources, module files, and workflows are LF in the working tree too (RF-025, BACKLOG TST-02), so
# `gofmt -l` and the scripts in containers see the same bytes as CI on Linux.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
