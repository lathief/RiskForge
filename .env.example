APP_NAME=RiskForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=
# Access token lifetime in minutes (1-1440).
JWT_TTL=60
DEMO_USER_PASSWORD=

# Optional overrides; defaults live in config/. Left commented so they never shadow
# values passed on the command line (tests run with HASH_BCRYPT_ROUNDS=4).
# bcrypt cost (10-14):
# HASH_BCRYPT_ROUNDS=12
# Concurrent password checks (0 = number of CPUs) and max wait for a slot in ms (1-2500):
# HASH_MAX_CONCURRENT=0
# HASH_QUEUE_TIMEOUT_MS=1000
# Also print logs (including activity/error/lifetime/query JSON) to stdout; the release
# Dockerfile sets this to true:
# LOG_PRINT=false
# Redacted request/response bodies in activity.log; set false when handling real personal data:
# LOG_HTTP_BODIES=true
# LOG_MAX_BODY_BYTES=8192
# LOG_SLOW_QUERY_MS=200

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
