APP_NAME=RiskForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=
# Access token lifetime in minutes (1-1440).
JWT_TTL=60
DEMO_USER_PASSWORD=

# Swagger UI (/swagger) and /openapi.yaml; only allowed with APP_ENV=local|testing.
DOCS_ENABLED=false

# Optional overrides; defaults live in config/. Left commented so they never shadow
# values passed on the command line (tests run with HASH_BCRYPT_ROUNDS=4).
# bcrypt cost (10-14):
# HASH_BCRYPT_ROUNDS=12
# Concurrent password checks (0 = number of CPUs) and max wait for a slot in ms (1-2500):
# HASH_MAX_CONCURRENT=0
# HASH_QUEUE_TIMEOUT_MS=1000
# Also print logs (including activity/error/lifetime/query JSON) to stdout; the release
# Dockerfile sets this to true:
# LOG_PRINT=false
# Write activity/error/lifetime/query files in storage/logs (release image: false, stdout only):
# LOG_FILES=true
# Redacted request/response bodies in activity.log; set false when handling real personal data:
# LOG_HTTP_BODIES=true
# LOG_MAX_BODY_BYTES=8192
# LOG_SLOW_QUERY_MS=200
# Rate limits (RF-023), token bucket per client, in memory, per process. per_min is the sustained
# rate, burst the number of requests allowed at once (1-100000 and 1-10000). RATE_LIMIT_ENABLED=false
# turns every limiter off. Login counts per client address; the others per authenticated caller.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MIN=30
# RATE_LIMIT_LOGIN_BURST=10
# RATE_LIMIT_DECISION_PER_MIN=1200
# RATE_LIMIT_DECISION_BURST=100
# RATE_LIMIT_ANALYSIS_PER_MIN=60
# RATE_LIMIT_ANALYSIS_BURST=20
# Load shedding (M5 validation): requests handled at once. Beyond it a request is refused with 503
# SERVICE_BUSY and Retry-After: 1. 0 to 10000; 0 switches it off; /health/* is never refused. Default 64.
# HTTP_MAX_IN_FLIGHT=64
# Behind a reverse proxy: the header that carries the client address (for example X-Forwarded-For)
# and the proxies allowed to set it (comma separated addresses or CIDR prefixes). Both or neither:
# a header without trusted proxies is refused at start, because any client could set it.
# HTTP_PROXY_HEADER=
# HTTP_TRUSTED_PROXIES=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
